{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "app-win",
      "displayName": "Win App (Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/app-win",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{QT_ROOT_DIR}/",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/x64-windows-qt-toolchain.cmake",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install"
      }
    },
    {
      "name": "app-linux",
      "displayName": "Linux App (Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/app-linux",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{QT_ROOT_DIR}/",
        "Qt6_DIR": "$env{QT_ROOT_DIR}/",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/x64-linux-clang-toolchain.cmake"
      }
    },
    {
      "name": "gtest-debug-clang",
      "displayName": "GTest Clang (Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/gtest-clang",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{QT_ROOT_DIR}",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/gtest-clang-toolchain.cmake",
        "BUILD_APP": "OFF"
      }
    }
  ]
}
