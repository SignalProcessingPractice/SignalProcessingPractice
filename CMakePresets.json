{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "app-win",
      "displayName": "Win App (Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/app",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/x64-windows-clang-toolchain.cmake",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "app-linux",
      "displayName": "Linux App (Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/app",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/x64-linux-clang-toolchain.cmake",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "gtest-debug-gcc",
      "displayName": "GTest GCC (Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/gtest-gcc",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/gtest-gcc-toolchain.cmake",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ]
}
